{
    "config": {
        "platform": {
            "php": "8.3.99"
        },
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0 || ~8.6.0",
        "laminas/laminas-servicemanager": "^4.5.1",
        "psr/container": "^1 || ^2.0.2"
    },
    "require-dev": {
        "psalm/plugin-phpunit": "^0.19.7",
        "roave/infection-static-analysis-plugin": "^1.40",
        "vimeo/psalm": "^6.16.1"
    },
    "autoload": {
        "psr-4": {
            "Laminas\\Paginator\\": "../../src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LaminasTest\\Paginator\\": "../../test/"
        }
    }
}